#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define SCRLM 1
#define SCRLH 2
#define DEVICE 3
#define BLTH 4
#define SNIPE 5

// --- CHIP INTEGRATED INPUT LISTENER (Fixes Undefined Label Error) ---
/ {
  
  behaviors {
    lt_bt: layer_tap_bluetooth {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "tap-preferred";
      tapping-term-ms = <200>;
      bindings = <&mo>, <&mkp>;
    };

    lt_dev: layer_tap_device {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "tap-preferred";
      tapping-term-ms = <200>;
      bindings = <&mo>, <&mkp>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    // LAYER 0: BASE LAYER
    default_layer {
      display-name = "Default";
      bindings = <
        &lt_bt BLTH MB4    &lt_dev DEVICE MB5    &mo SCRLM    &mkp RCLK
        &mkp LCLK                                             &mkp MCLK
      >;
    };

    // LAYER 1: MOMENTARY SCROLL LAYER (While holding Button 3 down)
    scroll_tap_layer {
      display-name = "Scroll";
      bindings = <
        &trans             &trans                &trans       &to SCRLH
        &trans                                                &tog SNIPE
      >;
    };

    // LAYER 2: SCROLL LOCK LAYER (Stays active until you tap a top-row button)
    scroll_hold_layer {
      display-name = "Scroll-Lock";
      bindings = <
        &to DEFAULT        &to DEFAULT           &to DEFAULT  &to DEFAULT
        &trans                                                &trans
      >;
    };

    // LAYER 3: DEVICE UTILITY LAYER (Hold Button 2)
    device_layer {
      display-name = "Device";
      bindings = <
        &bootloader        &trans                &trans       &trans
        &trans                                                &bt BT_CLR
      >;
    };

    // LAYER 4: BLUETOOTH SELECTION LAYER (Hold Button 1)
    bluetooth_layer {
      display-name = "Bluetooth";
      bindings = <
        &trans             &bt BT_SEL 0          &bt BT_SEL 1 &bt BT_SEL 2
        &bt BT_SEL 3                                          &bt BT_SEL 4
      >;
    };

    // LAYER 5: SNIPE LAYER (Precision 50% Speed Mode)
    snipe_layer {
      display-name = "Snipe";
      bindings = <
        &trans             &trans                &trans       &trans
        &trans                                                &trans
      >;
    };
  };
};
